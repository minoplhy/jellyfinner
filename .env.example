# Required, with no default: auto or manual. Changing it later needs an
# explicit mode switch, because the database remembers the active mode.
ENCODE_MODE=auto

DB_PATH=/var/lib/jellyfinner/state.db

# Jellyfin's library points at LIBRARY_DIR only. INCOMING_DIR and LIBRARY_DIR
# must be on the same filesystem, so a publish is one atomic rename.
ORIGINALS_DIR=/srv/originals
LIBRARY_DIR=/srv/library
INCOMING_DIR=/srv/incoming

# Only for workers using --transfer rclone. Workers normally transfer through
# the control API and need neither. Set both or neither.
#REMOTE_ORIGINALS=origin:/srv/originals
#REMOTE_INCOMING=origin:/srv/incoming

# Without TLS_CERT and TLS_KEY the address must be private, such as WireGuard.
CONTROL_ADDR=10.8.0.1:8200
#TLS_CERT=/etc/jellyfinner/control.crt
#TLS_KEY=/etc/jellyfinner/control.key
# Reverse proxies in front of the control API or admin UI, comma-separated. Only
# these can name the real client, for allowlists and failed-login limits.
#TRUSTED_PROXIES=127.0.0.1

# How nodes reach the control API. orchestrator node add prints it in a new
# node's settings. It may have a path, such as https://example.com/jellyfinner,
# which the control API also answers under. Nodes live in the database, and
# need no restart:
#   orchestrator node add worker1 [--allow 10.8.0.2/32]
#   orchestrator node add edge1 --edge --url https://edge1.example.com --quota-gb 500
CONTROL_URL=http://10.8.0.1:8200

# Optional, shown with their defaults.
#SCAN_INTERVAL=5m
#STABLE_FOR=5m
#DELETE_GRACE=24h
#MASS_DELETE_PERCENT=20
#LEASE_FOR=2m
# Attempt n waits n times this, so a short outage cannot use up every attempt.
#RETRY_DELAY=1m
#MAX_ATTEMPTS=3
#LIBRARY_DEBOUNCE=30s

# Output settings, sent to the worker with every job. Changing them makes
# backfill rebuild finished titles once it is started.
#OUTPUT_MAX_WIDTH=1920
#OUTPUT_MAX_HEIGHT=1080
#OUTPUT_VIDEO_KBPS=8000
#OUTPUT_AUDIO_KBPS=160
#OUTPUT_KEYFRAME_SECS=3
# Comma-separated audio languages to keep, empty keeps all.
#OUTPUT_AUDIO_LANGUAGES=tha,eng

# Source data backfill may start per UTC day. Actual traffic is higher, because
# the encode is pushed back too. On a small CPU-only worker, size this from
# encode time, not traffic. 200 is far too much for one vCPU.
#BACKFILL_DAILY_GB=200

# Admin UI. Without ADMIN_TLS_CERT the address must be private, for use behind an
# HTTPS reverse proxy. Login goes through Jellyfin, for administrators only.
#ADMIN_ADDR=127.0.0.1:8202
# The address people open. It may have a path, such as
# https://example.com/jellyfinner-admin, and a proxy may strip it or not.
# An https address always marks the session cookie secure.
#ADMIN_URL=
#ADMIN_TLS_CERT=
#ADMIN_TLS_KEY=

# Prometheus metrics on a private address. Off when unset.
#METRICS_ADDR=127.0.0.1:8203

# Edge delivery, optional. Add nodes with orchestrator node add NAME --edge, and
# assign viewers on each edge node's Edit page or with orchestrator edge assign.
#EDGE_URL_TTL=24h
#ROUTER_ADDR=127.0.0.1:8204

# Optional in auto, where Jellyfin otherwise finds new files on its own
# schedule. Required in manual. If Jellyfin has a Base URL under Dashboard,
# Networking, include it, such as http://127.0.0.1:8096/jellyfin.
#JELLYFIN_URL=http://127.0.0.1:8096
#JELLYFIN_TOKEN=

# Manual mode only. Point the Jellyfin Webhook plugin's Generic destination at
# http://WEBHOOK_ADDR/webhook/jellyfin with the header X-Webhook-Token, send
# Playback Start events, and use deploy/jellyfin-webhook.json as the template.
# It is its own listener, not part of CONTROL_URL or ADMIN_URL. For Jellyfin on
# another machine, proxy a path to it; any prefix before /webhook/jellyfin works.
#WEBHOOK_ADDR=127.0.0.1:8201
#WEBHOOK_TOKEN=
# Set this if Jellyfin sees LIBRARY_DIR at another path, such as in a container.
#JELLYFIN_LIBRARY_DIR=/media
#NOTIFY_DISCORD_URL=
#NOTIFY_NTFY_URL=https://ntfy.sh/your-topic

# On-demand cloud workers, optional. Off unless CLOUD_PROVIDERS lists a
# provider. Add only the ones you want, in the order to try them; when one
# cannot start a server (stock, quota, outage), the next is tried. There is no
# default order. Needs an https CONTROL_URL that rented servers can reach.
# Billing rules and sources: deploy/docker/README.md, "Cloud workers".
#CLOUD_PROVIDERS=
#CLOUD_MAX=1
#CLOUD_WAIT=10m
#CLOUD_QUEUE_THRESHOLD=3
#CLOUD_IDLE=5m
#CLOUD_BOOT_TIMEOUT=10m
#CLOUD_MAX_LIFETIME=12h
#CLOUD_DELETE_TIMEOUT=15m
#CLOUD_MAX_HOURS_PER_DAY=8
# A daily spending cap, in the providers' shared currency. 0 is no cap.
#CLOUD_MAX_SPEND_PER_DAY=0
# Whether backfill alone may start servers.
#CLOUD_BACKFILL=false
#CLOUD_WORKER_IMAGE=ghcr.io/minoplhy/jellyfinner/worker:latest
#
# Each provider has the same settings, in alphabetical order here. TYPES and
# LOCATIONS are lists, tried in order. Use a project for Jellyfinner alone.
#CLOUD_CHERRY_TOKEN=
#CLOUD_CHERRY_PROJECT=
#CLOUD_CHERRY_TYPES=
#CLOUD_CHERRY_LOCATIONS=
#CLOUD_CHERRY_IMAGE=
#CLOUD_CHERRY_SSH_KEY=
#
#CLOUD_HETZNER_TOKEN=
#CLOUD_HETZNER_TYPES=
#CLOUD_HETZNER_LOCATIONS=
#CLOUD_HETZNER_IMAGE=docker-ce
#CLOUD_HETZNER_SSH_KEY=
