# /etc/jellyfinner/router.env, mode 600. On the Jellyfin server.
ORCHESTRATOR_URL=https://control.example.com
NODE_TOKEN=replace-with-the-token-from-node-add-router
# Jellyfin as this server reaches it, with its Base URL if it has one.
JELLYFIN_URL=http://127.0.0.1:8096
# A Jellyfin API key: Dashboard, API Keys.
JELLYFIN_TOKEN=replace-with-a-jellyfin-api-key
# The library folder as Jellyfin sees it.
JELLYFIN_LIBRARY_DIR=/srv/media
# Point the reverse proxy serving your Jellyfin hostname here.
ROUTER_ADDR=127.0.0.1:8204
