# Orchestrator node: orchestrator and router, one binary. Needs cgo for SQLite.
# Build from the repository root.
FROM golang:1.27-bookworm AS build
# One compile job, so builds fit on small machines.
ENV GOFLAGS=-p=1
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd cmd
COPY internal internal
RUN go build -o /out/orchestrator ./cmd/orchestrator

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 jellyfinner \
    && useradd -u 10001 -g 10001 -M -s /usr/sbin/nologin jellyfinner \
    && install -d -o 10001 -g 10001 -m 750 /var/lib/jellyfinner
COPY --from=build /out/orchestrator /usr/local/bin/orchestrator
USER 10001:10001
ENTRYPOINT ["orchestrator", "--env", "/nonexistent"]
CMD ["serve"]
